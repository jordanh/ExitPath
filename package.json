{
  "name": "exitpath",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, open-source guide for finding, comparing and switching to open-source alternatives.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node scripts/validate-catalog.ts",
    "check": "npm run validate && npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "check-links": "node scripts/check-links.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@fontsource-variable/vollkorn": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/alegreya-sans-sc": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
